# Required
SEEDLINGS_PASSWORD=
SEEDLINGS_API_KEY=

# Optional (defaults shown)
PORT=8787
SEEDLINGS_DB=./data/seedlings.db
SEEDLINGS_BASE_URL=https://opencode.ai/inference/go/openai/v1
SEEDLINGS_PIP_MODEL=glm-5.2
SEEDLINGS_INHABITANT_MODEL=glm-5.3-flash
SEEDLINGS_JSON_MODE=1
SEEDLINGS_MAX_TOKENS=8000
# low, medium, high, or empty to leave it to the provider
SEEDLINGS_REASONING_EFFORT=low
SEEDLINGS_DAYS_PER_REAL_DAY=4
SEEDLINGS_TICK_MS=5000
SEEDLINGS_SEED=1
SEEDLINGS_MONTHLY_ALLOWANCE=60
SEEDLINGS_PERIOD_START_DAY=1
# Set to 1 to run with a stand-in model that costs nothing
# SEEDLINGS_FAKE_MODEL=1
